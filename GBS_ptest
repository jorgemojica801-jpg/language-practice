            { passage: "p1", q: "What do critics call for in response to these manipulative techniques?", options: ["More emotional appeal.", "Stricter regulations.", "Cheaper products.", "Better engine specifications."], a: 1 },
            
            // Reading Comprehension 2 (Q53 - Q59)
            { passage: "p2", q: "What is the main advantage of AI algorithms over human professionals mentioned?", options: ["They are more empathetic towards patients.", "They are cheaper to employ.", "They can perform physical surgeries better.", "They exhibit unprecedented capacity to analyze vast datasets with precision."], a: 3 },
            { passage: "p2", q: "What does the 'black box' dilemma refer to in the passage?", options: ["The opacity of algorithmic decision-making.", "The physical hardware storing the AI.", "The secure storage of patient data.", "The ethical board reviewing AI practices."], a: 0 },
            { passage: "p2", q: "According to the passage, predictive analytics can help by:", options: ["Generating new medications in the lab.", "Automatically billing patients for treatments.", "Foreseeing patient deterioration to facilitate preemptive interventions.", "Replacing nurses entirely."], a: 2 },
            { passage: "p2", q: "Which word best describes the author's tone regarding the integration of AI in healthcare?", options: ["Blindly optimistic", "Cautiously optimistic and analytical", "Harshly critical", "Completely indifferent"], a: 1 },
            { passage: "p2", q: "What is historically mentioned about diagnostic processes?", options: ["They were always perfect.", "They relied solely on machinery.", "They were faster than AI.", "They were susceptible to human error and fatigue."], a: 3 },
            { passage: "p2", q: "What kind of AI models are specifically mentioned as analyzing medical imagery?", options: ["Deep learning models", "Natural language processors", "Robotic surgery arms", "Basic statistical algorithms"], a: 0 },
            { passage: "p2", q: "What is required due to the ethical complexities of AI in healthcare?", options: ["Immediate cessation of AI use.", "More 'black boxes'.", "A nuanced regulatory framework.", "Complete replacement of human doctors."], a: 2 }
        ];

        let currentQuestionIndex = 0;
        let userAnswers = new Array(questions.length).fill(null);
        
        const views = {
            welcome: document.getElementById('welcome-view'),
            mcq: document.getElementById('mcq-view'),
            writing: document.getElementById('writing-view'),
            result: document.getElementById('result-view')
        };
        
        const welcomeUI = {
            firstName: document.getElementById('first-name'),
            lastName: document.getElementById('last-name'),
            email: document.getElementById('email'),
            error: document.getElementById('form-error')
        };

        const modalUI = {
            overlay: document.getElementById('submit-modal'),
            cancelBtn: document.getElementById('cancel-submit-btn'),
            confirmBtn: document.getElementById('confirm-submit-btn')
        };
        
        const mcqUI = {
            progress: document.getElementById('mcq-progress'),
            counter: document.getElementById('question-counter'),
            text: document.getElementById('mcq-text'),
            options: document.getElementById('mcq-options'),
            prevBtn: document.getElementById('prev-btn'),
            nextBtn: document.getElementById('next-btn'),
            toWritingBtn: document.getElementById('to-writing-btn'),
            passageContainer: document.getElementById('passage-container'),
            passageTitle: document.getElementById('passage-title'),
            passageText: document.getElementById('passage-text')
        };

        const writingUI = {
            area: document.getElementById('writing-area'),
            wordCount: document.getElementById('word-count'),
            finishBtn: document.getElementById('finish-btn')
        };

        function switchView(viewName) {
            Object.values(views).forEach(v => v.classList.add('hidden'));
            views[viewName].classList.remove('hidden');
        }

        document.getElementById('start-btn').addEventListener('click', () => {
            const fName = welcomeUI.firstName.value.trim();
            const lName = welcomeUI.lastName.value.trim();
            const email = welcomeUI.email.value.trim();

            if (!fName || !lName || !email) {
                welcomeUI.error.classList.remove('hidden');
                return;
            }
            
            welcomeUI.error.classList.add('hidden');
            
            // Set data for results view
            document.getElementById('result-name').textContent = `${fName} ${lName}`;
            document.getElementById('result-email').textContent = email;

            switchView('mcq');
            renderQuestion();
        });

        function renderQuestion() {
            const q = questions[currentQuestionIndex];
            
            // Progress
            const progressPct = ((currentQuestionIndex) / questions.length) * 100;
            mcqUI.progress.style.width = `${progressPct}%`;
            mcqUI.counter.textContent = `Part 1: Q ${currentQuestionIndex + 1} / 59`;

            // Animations
            mcqUI.text.classList.remove('fade-in');
            mcqUI.options.classList.remove('fade-in');
            void mcqUI.text.offsetWidth; 
            mcqUI.text.classList.add('fade-in');
            mcqUI.options.classList.add('fade-in');

            // Handling Reading Passages layout
            if (q.passage && passages[q.passage]) {
                const p = passages[q.passage];
                mcqUI.passageTitle.textContent = p.title;
                mcqUI.passageText.textContent = p.text;
                // Show left column
                mcqUI.passageContainer.classList.remove('hidden');
                mcqUI.passageContainer.classList.add('flex');
            } else {
                // Hide left column entirely
                mcqUI.passageContainer.classList.add('hidden');
                mcqUI.passageContainer.classList.remove('flex');
            }

            mcqUI.text.textContent = q.q;
            mcqUI.options.innerHTML = '';

            q.options.forEach((optText, index) => {
                const isSelected = userAnswers[currentQuestionIndex] === index;
                
                const optDiv = document.createElement('div');
                optDiv.className = `cursor-pointer p-4 md:p-5 border-2 rounded-xl flex items-center gap-4 transition-all duration-200
                    ${isSelected ? 'bg-turia-50 border-turia-600 shadow-md' : 'border-gray-200 hover:border-turia-400 hover:bg-gray-50'}`;
                
                optDiv.onclick = () => {
                    userAnswers[currentQuestionIndex] = index;
                    renderQuestion();
                };

                const letterBox = document.createElement('div');
                const letters = ['A', 'B', 'C', 'D'];
                letterBox.className = `w-10 h-10 rounded-lg flex items-center justify-center font-bold text-base shrink-0 transition-colors
                    ${isSelected ? 'bg-turia-600 text-white' : 'bg-gray-200 text-gray-600'}`;
                letterBox.textContent = letters[index];

                const textSpan = document.createElement('span');
                textSpan.className = `text-gray-800 font-medium text-lg ${isSelected ? 'text-turia-900' : ''}`;
                textSpan.textContent = optText;

                optDiv.appendChild(letterBox);
                optDiv.appendChild(textSpan);
                mcqUI.options.appendChild(optDiv);
            });

            // Reset scroll position for the question wrapper when moving to a new question
            document.querySelector('#question-wrapper > div').scrollTop = 0;
            
            updateMCQButtons();
        }

        function updateMCQButtons() {
            const hasAnswered = userAnswers[currentQuestionIndex] !== null;

            mcqUI.prevBtn.disabled = currentQuestionIndex === 0;

            if (currentQuestionIndex === questions.length - 1) {
                mcqUI.nextBtn.classList.add('hidden');
                mcqUI.toWritingBtn.classList.remove('hidden');
                mcqUI.toWritingBtn.disabled = !hasAnswered;
            } else {
                mcqUI.toWritingBtn.classList.add('hidden');
                mcqUI.nextBtn.classList.remove('hidden');
                mcqUI.nextBtn.disabled = !hasAnswered;
            }
        }

        mcqUI.prevBtn.addEventListener('click', () => {
            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                renderQuestion();
            }
        });

        mcqUI.nextBtn.addEventListener('click', () => {
            if (currentQuestionIndex < questions.length - 1) {
                currentQuestionIndex++;
                renderQuestion();
            }
        });

        mcqUI.toWritingBtn.addEventListener('click', () => {
            mcqUI.progress.style.width = '100%';
            setTimeout(() => {
                switchView('writing');
            }, 300);
        });

        writingUI.area.addEventListener('input', () => {
            const text = writingUI.area.value.trim();
            const words = text === '' ? 0 : text.split(/\s+/).length;
            writingUI.wordCount.textContent = `Word count: ${words}`;
            
            if (words > 0 && words < 250) {
                writingUI.wordCount.classList.add('text-red-600', 'border-red-300', 'bg-red-50');
                writingUI.wordCount.classList.remove('text-gray-500', 'border-gray-300', 'bg-white');
            } else {
                writingUI.wordCount.classList.remove('text-red-600', 'border-red-300', 'bg-red-50');
                writingUI.wordCount.classList.add('text-gray-500', 'border-gray-300', 'bg-white');
            }
        });

        writingUI.finishBtn.addEventListener('click', () => {
            modalUI.overlay.classList.remove('hidden');
        });

        modalUI.cancelBtn.addEventListener('click', () => {
            modalUI.overlay.classList.add('hidden');
        });

        modalUI.confirmBtn.addEventListener('click', () => {
            modalUI.overlay.classList.add('hidden');
            calculateAndShowResults();
        });

        function calculateAndShowResults() {
            let score = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questions[idx].a) {
                    score++;
                }
            });

            document.getElementById('final-score').textContent = score;

            let cefr = '';
            let desc = '';
            
            if (score <= 12) { cefr = 'A1'; desc = 'Beginner'; } 
            else if (score <= 24) { cefr = 'A2'; desc = 'Elementary'; } 
            else if (score <= 36) { cefr = 'B1'; desc = 'Intermediate'; } 
            else if (score <= 48) { cefr = 'B2'; desc = 'Upper Intermediate'; } 
            else { cefr = 'C1'; desc = 'Advanced'; }

            document.getElementById('final-level').textContent = cefr;
            document.getElementById('level-desc').textContent = desc;

            const essayText = writingUI.area.value.trim();
            const essayContainer = document.getElementById('submitted-essay');
            if (essayText === '') {
                essayContainer.innerHTML = '<span class="text-gray-400 italic">No essay submitted.</span>';
            } else {
                essayContainer.textContent = essayText; 
            }

            switchView('result');
        }

    </script>
</body>
</html>
